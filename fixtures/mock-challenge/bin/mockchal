#!/usr/bin/env node
// Fake yukon challenge CLI. Mirrors the argv surface of ecdsafail/mlxfast:
//   mockchal setup | run | submit --note-file <f> [--model <m>] [--claimed-score <s>]
//   mockchal submissions [--all] | sync | config
// State lives in <repoRoot>/.mockchal/submissions.json (repoRoot = dir containing benchmark.json,
// found by walking up from cwd).

import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as path from "node:path";

function findRepoRoot(start) {
  let dir = start;
  while (true) {
    if (fs.existsSync(path.join(dir, "benchmark.json"))) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) {
      console.error("mockchal: no benchmark.json found from cwd upward");
      process.exit(1);
    }
    dir = parent;
  }
}

const repoRoot = findRepoRoot(process.cwd());
const stateDir = path.join(repoRoot, ".mockchal");
const subsFile = path.join(stateDir, "submissions.json");

const SEED_COMPETITORS = [
  {
    id: "seed-aaaa1111",
    score: 26,
    author: "competitor-alpha",
    note: "Baseline sweep of x only; y untouched. Suspect y=-1 is optimal.",
    promoted: true,
    createdAt: "2026-07-01T00:00:00Z",
  },
  {
    id: "seed-bbbb2222",
    score: 18,
    author: "competitor-beta",
    note: "Coordinate descent, 2 rounds. Converging toward (3,-1) slowly.",
    promoted: true,
    createdAt: "2026-07-10T00:00:00Z",
  },
];

function loadSubs() {
  if (!fs.existsSync(subsFile)) return { submissions: [...SEED_COMPETITORS] };
  return JSON.parse(fs.readFileSync(subsFile, "utf8"));
}

function saveSubs(data) {
  fs.mkdirSync(stateDir, { recursive: true });
  fs.writeFileSync(subsFile, JSON.stringify(data, null, 2) + "\n");
}

function bestScore(data) {
  const scores = data.submissions.filter((s) => s.promoted).map((s) => s.score);
  return scores.length ? Math.min(...scores) : null; // direction "-"
}

function parseFlags(argv) {
  const flags = {};
  const rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith("--")) {
        flags[key] = next;
        i++;
      } else {
        flags[key] = true;
      }
    } else {
      rest.push(a);
    }
  }
  return { flags, rest };
}

const [, , cmd, ...args] = process.argv;
const { flags } = parseFlags(args);

switch (cmd) {
  case "setup": {
    execFileSync("./setup.sh", { cwd: repoRoot, stdio: "inherit" });
    break;
  }
  case "run": {
    execFileSync("./benchmark.sh", { cwd: repoRoot, stdio: "inherit" });
    break;
  }
  case "submit": {
    const noteFile = flags["note-file"];
    if (!noteFile) {
      console.error("mockchal submit: --note-file is required");
      process.exit(1);
    }
    const notePath = path.resolve(process.cwd(), noteFile);
    if (!fs.existsSync(notePath) || fs.readFileSync(notePath, "utf8").trim() === "") {
      console.error(`mockchal submit: note file missing or empty: ${noteFile}`);
      process.exit(1);
    }
    const scorePath = path.join(repoRoot, "score.json");
    if (!fs.existsSync(scorePath)) {
      console.error("mockchal submit: no score.json — run the benchmark first");
      process.exit(1);
    }
    const score = JSON.parse(fs.readFileSync(scorePath, "utf8")).score;
    const data = loadSubs();
    const best = bestScore(data);
    const promoted = best === null || score < best;
    const id = `sub-${Math.random().toString(36).slice(2, 10)}`;
    data.submissions.push({
      id,
      score,
      author: "me",
      note: fs.readFileSync(notePath, "utf8"),
      model: flags["model"] ?? null,
      promoted,
      createdAt: new Date().toISOString(),
    });
    saveSubs(data);
    console.log(`Submitted ${id} (score ${score})${promoted ? " — PROMOTED (new best)" : " — not promoted (does not beat current best)"}`);
    break;
  }
  case "submissions": {
    const data = loadSubs();
    const rows = flags["all"] ? data.submissions : data.submissions.filter((s) => s.author === "me");
    console.log("ID\tSCORE\tAUTHOR\tPROMOTED\tCREATED");
    for (const s of rows) {
      console.log(`${s.id}\t${s.score}\t${s.author}\t${s.promoted ? "yes" : "no"}\t${s.createdAt}`);
    }
    break;
  }
  case "sync": {
    const data = loadSubs();
    const best = bestScore(data);
    console.log(best === null ? "Nothing to sync (no promoted submissions)" : `Synced to best promoted submission (score ${best})`);
    break;
  }
  case "config": {
    console.log(`api: mock://localhost\nbenchmark: mock-challenge\nstate: ${stateDir}`);
    break;
  }
  default: {
    console.error(`mockchal: unknown command ${cmd ?? "(none)"}. Commands: setup run submit submissions sync config`);
    process.exit(1);
  }
}
