{
  "name": "kydoresearch",
  "version": "0.1.0",
  "description": "Pi harness for yukon AutoResearch challenges (professor/PhD/God loop)",
  "keywords": [
    "pi-package",
    "autoresearch",
    "yukon"
  ],
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/autoresearch/index.ts"
    ]
  },
  "scripts": {
    "mock": "bash scripts/mock-demo.sh",
    "test": "vitest --run",
    "test:kernel": "node scripts/test-impact.ts --mode related --kernel",
    "test:phase": "node scripts/test-impact.ts --mode phase",
    "test:related": "node scripts/test-impact.ts --mode related",
    "test:explain": "node scripts/test-impact.ts --mode related --explain",
    "test:full": "node scripts/test-impact.ts --mode full",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.8",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
