  "rules": [
    {
      "patterns": ["src/init.ts", "extensions/autoresearch/prompts/setup.md", "extensions/autoresearch/prompts/tasks/init-*.md", "extensions/autoresearch/agents/setup/**"],
      "phases": ["setup"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Setup readiness, baseline, and persistence contract"
    },
    {
      "patterns": ["src/initialization.ts", "extensions/autoresearch/onboarding.ts"],
      "phases": ["setup", "ui"],
      "tiers": ["phase-contract", "phase-flow", "integration", "pty"],
      "reason": "Guided onboarding and durable initialization reporting boundary"
    },
    {
      "patterns": ["src/steering.ts", "extensions/autoresearch/prompts/professor.md", "extensions/autoresearch/prompts/tasks/propose.md", "extensions/autoresearch/agents/professor/**"],
      "phases": ["professor"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Professor proposal and steering contract"
    },
    {
      "patterns": ["src/integrity.ts", "src/worktree.ts", "extensions/autoresearch/prompts/phd.md", "extensions/autoresearch/prompts/tasks/implement.md", "extensions/autoresearch/prompts/tasks/write-note.md", "extensions/autoresearch/agents/phd/**"],
      "phases": ["phd"],
      "tiers": ["phase-contract", "phase-flow", "integration"],
      "reason": "PhD implementation and candidate integrity contract"
    },
    {
      "patterns": ["src/advisor.ts", "extensions/autoresearch/prompts/advisor.md", "extensions/autoresearch/prompts/tasks/advise.md", "extensions/autoresearch/agents/advisor/**"],
      "phases": ["advisor"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Advisor evidence review contract"
    },
    {
      "patterns": ["src/worktree.ts"],
      "phases": ["finalization"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Finalist application boundary"
    },
    {
      "patterns": ["src/challenge/**"],
      "phases": ["setup", "finalization"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Setup scoring and deterministic challenge boundary"
    },
    {
      "patterns": ["extensions/autoresearch/prompts/god.md", "extensions/autoresearch/prompts/tasks/church.md", "extensions/autoresearch/agents/god/**"],
      "phases": ["church"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Church reflection contract"
    },
    {
      "patterns": ["src/metaharness.ts", "extensions/autoresearch/prompts/metaharness.md", "extensions/autoresearch/agents/metaharness/**"],
      "phases": ["metaharness"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Frozen meta-harness evaluator and profile contract"
    },
    {
      "patterns": ["extensions/autoresearch/widget.ts", "extensions/autoresearch/config-ui.ts", "extensions/autoresearch/commands.ts", "extensions/autoresearch/index.ts", "extensions/autoresearch/inspect.ts", "extensions/autoresearch/agent-monitor.ts", "extensions/autoresearch/research-editor.ts", "extensions/autoresearch/trace-view.ts", "extensions/autoresearch/*-tool.ts"],
      "phases": ["ui"],
      "tiers": ["kernel", "phase-contract", "phase-flow", "integration", "pty"],
      "reason": "Interactive Pi control-plane semantics"
    },
    {
      "patterns": ["src/archive.ts"],
      "phases": ["professor", "phd", "finalization"],
      "tiers": ["phase-contract", "phase-flow"],
      "reason": "Shared candidate evidence and lineage boundary",
      "escalateToFull": true
    },
    {
      "patterns": ["src/orchestrator.ts", "src/state.ts", "src/phases.ts", "src/experiments.ts", "src/retry.ts", "src/exec.ts", "src/util.ts", "src/config.ts", "src/agent-activity.ts", "src/agents/types.ts", "src/agents/subprocess.ts", "src/agents/mock.ts", "src/agents/mock-scripts.ts", "src/telemetry.ts"],
      "phases": [],
      "tiers": ["full"],
      "reason": "Shared lifecycle, state, task, retry, runner, or evaluator foundation",
      "escalateToFull": true
    },
    {
      "patterns": ["package.json", "package-lock.json", "tsconfig.json", "vitest.config.ts", "scripts/**", "test/impact-map.json", "test/helpers/**", "src/test-system/**", ".github/**"],
      "phases": [],
      "tiers": ["full"],
      "reason": "Package, dependency, test configuration, or test infrastructure",
      "escalateToFull": true
    }
  ]
}
